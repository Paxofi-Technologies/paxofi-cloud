{
  "$description": "PaxofiCloud design tokens v1 (W3C Design Tokens Community Group format). Source of truth for CSS and for the Figma rebuild. Brand colours from PKDMS: Navy #0B1F3A, Blue #2F6BFF, Teal #00BFA6; typeface Inter.",
  "color": {
    "$type": "color",
    "brand": {
      "navy": {
        "$value": "#0B1F3A",
        "$description": "PKDMS Primary Navy"
      },
      "blue": {
        "$value": "#2F6BFF",
        "$description": "PKDMS Primary Blue — accents, focus, large text only"
      },
      "teal": {
        "$value": "#00BFA6",
        "$description": "PKDMS Accent Teal — decorative only, never text on white"
      }
    },
    "neutral": {
      "0": {
        "$value": "#FFFFFF"
      },
      "50": {
        "$value": "#F5F7FA"
      },
      "100": {
        "$value": "#EBEFF5"
      },
      "200": {
        "$value": "#DDE3EC"
      },
      "300": {
        "$value": "#C4CDDA"
      },
      "400": {
        "$value": "#8592A6"
      },
      "500": {
        "$value": "#5B6678"
      },
      "600": {
        "$value": "#434D5E"
      },
      "700": {
        "$value": "#2E3747"
      },
      "800": {
        "$value": "#1B2433"
      },
      "900": {
        "$value": "{color.brand.navy}"
      }
    },
    "blue": {
      "50": {
        "$value": "#EEF3FF"
      },
      "100": {
        "$value": "#DCE6FF"
      },
      "500": {
        "$value": "{color.brand.blue}"
      },
      "600": {
        "$value": "#1F56E0"
      },
      "700": {
        "$value": "#1B47B8"
      }
    },
    "teal": {
      "50": {
        "$value": "#E6FAF6"
      },
      "500": {
        "$value": "{color.brand.teal}"
      },
      "700": {
        "$value": "#007F6E"
      }
    },
    "green": {
      "50": {
        "$value": "#E8F7EE"
      },
      "700": {
        "$value": "#1A6E3C"
      }
    },
    "amber": {
      "50": {
        "$value": "#FFF6E0"
      },
      "700": {
        "$value": "#8A5300"
      }
    },
    "red": {
      "50": {
        "$value": "#FDEDEE"
      },
      "600": {
        "$value": "#C62F3E"
      },
      "700": {
        "$value": "#A32432"
      }
    },
    "navyTint": {
      "200": {
        "$value": "#C9D6EA"
      },
      "300": {
        "$value": "#9FB4D3"
      },
      "400": {
        "$value": "#8FA6C7"
      }
    }
  },
  "semantic": {
    "$type": "color",
    "text": {
      "primary": {
        "$value": "{color.neutral.800}"
      },
      "secondary": {
        "$value": "{color.neutral.500}"
      },
      "inverse": {
        "$value": "{color.neutral.0}"
      },
      "link": {
        "$value": "{color.blue.600}"
      },
      "brand": {
        "$value": "{color.brand.navy}"
      }
    },
    "surface": {
      "page": {
        "$value": "{color.neutral.50}"
      },
      "card": {
        "$value": "{color.neutral.0}"
      },
      "subtle": {
        "$value": "{color.neutral.100}"
      },
      "inverse": {
        "$value": "{color.brand.navy}"
      }
    },
    "border": {
      "default": {
        "$value": "{color.neutral.200}"
      },
      "strong": {
        "$value": "{color.neutral.300}"
      },
      "input": {
        "$value": "{color.neutral.400}"
      }
    },
    "action": {
      "primary": {
        "$value": "{color.blue.600}"
      },
      "primaryHover": {
        "$value": "{color.blue.700}"
      },
      "onPrimary": {
        "$value": "{color.neutral.0}"
      },
      "secondary": {
        "$value": "{color.neutral.0}"
      },
      "secondaryHover": {
        "$value": "{color.neutral.100}"
      },
      "onSecondary": {
        "$value": "{color.neutral.800}"
      },
      "danger": {
        "$value": "{color.red.600}"
      },
      "dangerHover": {
        "$value": "{color.red.700}"
      }
    },
    "focus": {
      "ring": {
        "$value": "{color.brand.blue}"
      }
    },
    "feedback": {
      "successText": {
        "$value": "{color.green.700}"
      },
      "successSurface": {
        "$value": "{color.green.50}"
      },
      "warningText": {
        "$value": "{color.amber.700}"
      },
      "warningSurface": {
        "$value": "{color.amber.50}"
      },
      "dangerText": {
        "$value": "{color.red.700}"
      },
      "dangerSurface": {
        "$value": "{color.red.50}"
      },
      "infoText": {
        "$value": "{color.blue.700}"
      },
      "infoSurface": {
        "$value": "{color.blue.50}"
      },
      "accentText": {
        "$value": "{color.teal.700}"
      },
      "accentSurface": {
        "$value": "{color.teal.50}"
      }
    },
    "nav": {
      "text": {
        "$value": "{color.navyTint.200}"
      },
      "textMuted": {
        "$value": "{color.navyTint.400}"
      },
      "textActive": {
        "$value": "{color.neutral.0}"
      },
      "hover": {
        "$value": "rgba(255, 255, 255, 0.06)"
      },
      "active": {
        "$value": "rgba(47, 107, 255, 0.22)"
      },
      "brandSuffix": {
        "$value": "{color.navyTint.300}"
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Inter Variable",
          "Inter",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "monospace"
        ]
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "size": {
      "$type": "dimension",
      "xs": {
        "$value": "0.75rem"
      },
      "sm": {
        "$value": "0.875rem"
      },
      "md": {
        "$value": "1rem"
      },
      "lg": {
        "$value": "1.125rem"
      },
      "xl": {
        "$value": "1.375rem"
      },
      "2xl": {
        "$value": "1.75rem"
      },
      "3xl": {
        "$value": "2.25rem"
      }
    },
    "lineHeight": {
      "$type": "number",
      "tight": {
        "$value": 1.2
      },
      "normal": {
        "$value": 1.5
      }
    }
  },
  "space": {
    "$type": "dimension",
    "0": {
      "$value": "0"
    },
    "1": {
      "$value": "0.25rem"
    },
    "2": {
      "$value": "0.5rem"
    },
    "3": {
      "$value": "0.75rem"
    },
    "4": {
      "$value": "1rem"
    },
    "5": {
      "$value": "1.25rem"
    },
    "6": {
      "$value": "1.5rem"
    },
    "8": {
      "$value": "2rem"
    },
    "10": {
      "$value": "2.5rem"
    },
    "12": {
      "$value": "3rem"
    },
    "16": {
      "$value": "4rem"
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": "6px"
    },
    "md": {
      "$value": "10px"
    },
    "lg": {
      "$value": "16px"
    },
    "pill": {
      "$value": "999px"
    }
  },
  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": "0 1px 2px rgba(11, 31, 58, 0.06), 0 1px 3px rgba(11, 31, 58, 0.08)"
    },
    "md": {
      "$value": "0 4px 12px rgba(11, 31, 58, 0.08), 0 2px 4px rgba(11, 31, 58, 0.06)"
    },
    "focus": {
      "$value": "0 0 0 3px rgba(47, 107, 255, 0.35)"
    }
  },
  "motion": {
    "$type": "duration",
    "fast": {
      "$value": "120ms"
    },
    "base": {
      "$value": "200ms"
    }
  },
  "size": {
    "$type": "dimension",
    "control": {
      "$value": "2.75rem",
      "$description": "Minimum height of inputs and buttons (44px touch target, WCAG 2.5.8)"
    },
    "sidebar": {
      "$value": "16rem"
    },
    "content": {
      "$value": "72rem"
    }
  }
}
