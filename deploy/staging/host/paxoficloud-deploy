#!/usr/bin/env bash
# PaxofiCloud staging deploy agent: the ONLY command the `deploy` SSH user can
# run (sshd ForceCommand + authorized_keys `restrict,command=`), see
# docs/security/THREAT-MODEL-DEPLOY-PIPELINE.md (P-4, P-7, P-8, D-01, D-08, D-11).
#
# Verbs (from SSH_ORIGINAL_COMMAND; anything else is refused):
#   load               stdin: `docker save ... | gzip` of the two app images
#   mail-secrets       stdin: NAME=value lines for the mail worker (email
#                      threat model E-6); only allow-listed names and formats
#   web-secrets        stdin: NAME=value lines for the PHP web tier only
#                      (Turnstile keys, identity threat model §6.12)
#   release <sha>      migrate, start <sha>, health-check; roll back on failure
#   staff-bootstrap    stdin: EMAIL= and NAME= lines; invites the first staff
#                      Security Admin (identity threat model §6.19). Refused by
#                      the app once an active staff manager exists, except
#                      that the sole active Security Admin gets the founder
#                      roles (identity threat model §6.23)
#   status             current/previous version and container health
#
# Runtime secrets (DB/Redis passwords, the email outbox key pair, the MFA keys) are generated
# here on first release and never leave the host. Logs never print secret
# values (P-11).
set -euo pipefail
umask 077

ROOT="${PAXOFICLOUD_ROOT:-}"                      # test harness only; sshd passes no env
COMPOSE_FILE="$ROOT/opt/paxoficloud/compose.yaml"
ENV_DIR="$ROOT/etc/paxoficloud"
STATE_DIR="$ROOT/var/lib/paxoficloud"
LOG_FILE="$ROOT/var/log/paxoficloud/deploy.log"
HEALTH_URL="${PAXOFICLOUD_HEALTH_URL:-http://127.0.0.1:8080/health/ready}"
PROJECT=paxoficloud
MAX_IMAGE_STREAM_BYTES=$((2 * 1024 * 1024 * 1024))

log() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" | tee -a "$LOG_FILE" >&2; }
die() { log "ERROR $*"; exit 1; }

# The mail worker (compose profile "mail") runs only once a provider token exists.
mail_profile() {
  local f="$ENV_DIR/mail-providers.env"
  if grep -Eqs '^(POSTMARK_SERVER_TOKEN|RESEND_API_KEY)=.' "$f" \
     || { grep -Eqs '^SMTP_HOST=.' "$f" && grep -Eqs '^SMTP_PASSWORD_B64=.' "$f"; }; then echo mail; fi
}
compose() { APP_VERSION="$1" PAXOFICLOUD_ENV_DIR="$ENV_DIR" COMPOSE_PROFILES="$(mail_profile)" docker compose -p "$PROJECT" -f "$COMPOSE_FILE" "${@:2}"; }

RUNTIME_DB_USER=paxoficloud_app

# A one-off php container connected as the schema owner (§6.22). The owner's
# credentials come from owner.env through this process's environment
# (`-e NAME` copies the value without putting it on any command line).
as_owner() {
  local version="$1"; shift
  ( set -a; . "$ENV_DIR/owner.env"; set +a
    compose "$version" run --rm -T --no-deps -e DB_USERNAME -e DB_PASSWORD php bin/paxoficloud "$@" )
}

random_secret() { head -c 32 /dev/urandom | base64 | tr -d '/+=\n' | head -c 40; }

ensure_secrets() {
  local version="$1" f keys
  install -d -m 0700 "$ENV_DIR"
  for f in outbox-public.env outbox-secret.env mail-providers.env web.env identity-keys.env credential-intake-public.env credential-intake-secret.env provider-credential-keys.env payments-intake-public.env payments-intake-secret.env payments-credential-keys.env; do
    [ -e "$ENV_DIR/$f" ] || install -m 0600 /dev/null "$ENV_DIR/$f"
  done
  if [ ! -s "$ENV_DIR/app.env" ]; then
    # Two MySQL users (identity threat model §6.22): the schema owner runs only
    # migrate and db:grants; the long-running containers use the runtime user.
    local owner app redis
    owner="$(random_secret)"; app="$(random_secret)"; redis="$(random_secret)"
    printf 'DB_USERNAME=%s\nDB_PASSWORD=%s\nREDIS_PASSWORD=%s\n' "$RUNTIME_DB_USER" "$app" "$redis" > "$ENV_DIR/app.env"
    printf 'DB_USERNAME=paxoficloud\nDB_PASSWORD=%s\n' "$owner" > "$ENV_DIR/owner.env"
    printf 'MYSQL_RANDOM_ROOT_PASSWORD=yes\nMYSQL_DATABASE=paxoficloud\nMYSQL_USER=paxoficloud\nMYSQL_PASSWORD=%s\nMYSQL_APP_PASSWORD=%s\n' "$owner" "$app" > "$ENV_DIR/mysql.env"
    printf 'REDIS_PASSWORD=%s\n' "$redis" > "$ENV_DIR/redis.env"
    log "generated runtime secrets (values not logged)"
  fi
  if [ ! -s "$ENV_DIR/owner.env" ] || ! grep -qx "DB_USERNAME=$RUNTIME_DB_USER" "$ENV_DIR/app.env"; then
    # Secrets from before §6.22 would keep the web tier on the owner account.
    die "secrets predate the runtime database user; re-apply the staging infrastructure (new server)"
  fi
  if [ ! -s "$ENV_DIR/identity-keys.env" ]; then
    # TOTP secret key ring and recovery-code key (identity threat model §6.13):
    # 32 random bytes each, generated here, mounted into the php container only.
    printf 'MFA_SECRET_KEYS=k1:%s\nMFA_SECRET_ACTIVE_KEY=k1\nMFA_RECOVERY_KEY=%s\n' \
      "$(head -c 32 /dev/urandom | base64 -w0)" "$(head -c 32 /dev/urandom | base64 -w0)" > "$ENV_DIR/identity-keys.env"
    log "generated MFA keys (values not logged)"
  fi
  if [ ! -s "$ENV_DIR/outbox-public.env" ]; then
    # Email outbox key pair (E-3): the web tier gets the public half only.
    # libsodium in the release image, without booting the app (which needs MySQL).
    keys="$(compose "$version" run --rm -T --no-deps --entrypoint php php -r \
      '$k = sodium_crypto_box_keypair(); echo "EMAIL_OUTBOX_PUBLIC_KEY=", base64_encode(sodium_crypto_box_publickey($k)), "\n", "EMAIL_OUTBOX_SECRET_KEY=", base64_encode(sodium_crypto_box_secretkey($k)), "\n"; sodium_memzero($k);' \
      2>>"$LOG_FILE")" || die "release: could not generate the email outbox keys"
    grep -Eq '^EMAIL_OUTBOX_PUBLIC_KEY=[A-Za-z0-9+/]{43}=$' <<<"$keys" && grep -Eq '^EMAIL_OUTBOX_SECRET_KEY=[A-Za-z0-9+/]{43}=$' <<<"$keys" \
      || die "release: unexpected outbox key output"
    grep '^EMAIL_OUTBOX_SECRET_KEY=' <<<"$keys" > "$ENV_DIR/outbox-secret.env"
    grep '^EMAIL_OUTBOX_PUBLIC_KEY=' <<<"$keys" > "$ENV_DIR/outbox-public.env"
    log "generated email outbox key pair (values not logged)"
  fi
  if [ ! -s "$ENV_DIR/provider-credential-keys.env" ]; then
    # Provider-credential KEK (SEC-004): 32 random bytes, provider worker only (PC-6).
    printf 'PROVIDER_CREDENTIAL_KEYS=k1:%s\nPROVIDER_CREDENTIAL_ACTIVE_KEY=k1\n' "$(head -c 32 /dev/urandom | base64 -w0)" > "$ENV_DIR/provider-credential-keys.env"
    log "generated provider credential key (value not logged)"
  fi
  if [ ! -s "$ENV_DIR/credential-intake-public.env" ]; then
    # Credential intake key pair (PC-1): the web tier gets the public half only.
    keys="$(compose "$version" run --rm -T --no-deps --entrypoint php php -r \
      '$k = sodium_crypto_box_keypair(); echo "CREDENTIAL_INTAKE_PUBLIC_KEY=", base64_encode(sodium_crypto_box_publickey($k)), "\n", "CREDENTIAL_INTAKE_SECRET_KEY=", base64_encode(sodium_crypto_box_secretkey($k)), "\n"; sodium_memzero($k);' \
      2>>"$LOG_FILE")" || die "release: could not generate the credential intake keys"
    grep -Eq '^CREDENTIAL_INTAKE_PUBLIC_KEY=[A-Za-z0-9+/]{43}=$' <<<"$keys" && grep -Eq '^CREDENTIAL_INTAKE_SECRET_KEY=[A-Za-z0-9+/]{43}=$' <<<"$keys" \
      || die "release: unexpected credential intake key output"
    grep '^CREDENTIAL_INTAKE_SECRET_KEY=' <<<"$keys" > "$ENV_DIR/credential-intake-secret.env"
    grep '^CREDENTIAL_INTAKE_PUBLIC_KEY=' <<<"$keys" > "$ENV_DIR/credential-intake-public.env"
    log "generated credential intake key pair (values not logged)"
  fi
  if [ ! -s "$ENV_DIR/payments-credential-keys.env" ]; then
    # Payments key ring (PY-3): 32 random bytes, payments worker only.
    printf 'PAYMENTS_CREDENTIAL_KEYS=k1:%s\nPAYMENTS_CREDENTIAL_ACTIVE_KEY=k1\n' "$(head -c 32 /dev/urandom | base64 -w0)" > "$ENV_DIR/payments-credential-keys.env"
    log "generated payments credential key (value not logged)"
  fi
  if [ ! -s "$ENV_DIR/payments-intake-public.env" ]; then
    # Payments intake key pair (PY-3): the web tier gets the public half only.
    keys="$(compose "$version" run --rm -T --no-deps --entrypoint php php -r \
      '$k = sodium_crypto_box_keypair(); echo "PAYMENTS_INTAKE_PUBLIC_KEY=", base64_encode(sodium_crypto_box_publickey($k)), "\n", "PAYMENTS_INTAKE_SECRET_KEY=", base64_encode(sodium_crypto_box_secretkey($k)), "\n"; sodium_memzero($k);' \
      2>>"$LOG_FILE")" || die "release: could not generate the payments intake keys"
    grep -Eq '^PAYMENTS_INTAKE_PUBLIC_KEY=[A-Za-z0-9+/]{43}=$' <<<"$keys" && grep -Eq '^PAYMENTS_INTAKE_SECRET_KEY=[A-Za-z0-9+/]{43}=$' <<<"$keys" \
      || die "release: unexpected payments intake key output"
    grep '^PAYMENTS_INTAKE_SECRET_KEY=' <<<"$keys" > "$ENV_DIR/payments-intake-secret.env"
    grep '^PAYMENTS_INTAKE_PUBLIC_KEY=' <<<"$keys" > "$ENV_DIR/payments-intake-public.env"
    log "generated payments intake key pair (values not logged)"
  fi
}

cmd_mail_secrets() {
  # stdin: NAME=value lines. Unknown names or values outside the expected
  # format are refused as a whole; nothing is written unless all lines pass.
  local input line name value out
  local LC_ALL=C
  input="$(head -c 8192)"
  out="$(mktemp "$ENV_DIR/.mail-providers.XXXXXX")"; trap 'rm -f "$out"' RETURN
  while IFS= read -r line || [ -n "$line" ]; do
    [ -z "$line" ] && continue
    name="${line%%=*}"; value="${line#*=}"
    case "$name" in
      POSTMARK_SERVER_TOKEN) [[ "$value" =~ ^[A-Za-z0-9-]{0,128}$ ]] || die "mail-secrets: $name has an unexpected format" ;;
      RESEND_API_KEY)        [[ "$value" =~ ^(re_[A-Za-z0-9_]{8,128})?$ ]] || die "mail-secrets: $name has an unexpected format" ;;
      EMAIL_RECIPIENT_ALLOWLIST) [[ "$value" =~ ^[A-Za-z0-9@._+,\ -]{0,2000}$ ]] || die "mail-secrets: $name has an unexpected format" ;;
      EMAIL_PROVIDER)        [[ "$value" =~ ^(postmark|resend|smtp)?$ ]] || die "mail-secrets: $name has an unexpected format" ;;
      SMTP_HOST)             [[ "$value" =~ ^([a-z0-9-]{1,63}\.)+[a-z]{2,63}$ || -z "$value" ]] || die "mail-secrets: $name has an unexpected format" ;;
      SMTP_TLS_NAME)         [[ "$value" =~ ^([a-z0-9-]{1,63}\.)+[a-z]{2,63}$ || -z "$value" ]] || die "mail-secrets: $name has an unexpected format" ;;
      SMTP_PORT)             [[ "$value" =~ ^(465|587)?$ ]] || die "mail-secrets: $name has an unexpected format" ;;
      SMTP_USERNAME)         [[ "$value" =~ ^[A-Za-z0-9@._+-]{0,254}$ ]] || die "mail-secrets: $name has an unexpected format" ;;
      SMTP_PASSWORD)
        # Any printable password (no spaces). Stored base64-encoded so `$`,
        # quotes or `#` cannot be reinterpreted by the compose env file.
        [[ "$value" =~ ^[[:graph:]]{0,256}$ ]] || die "mail-secrets: $name has an unexpected format"
        name=SMTP_PASSWORD_B64
        if [ -n "$value" ]; then value="$(printf '%s' "$value" | base64 -w0)"; fi ;;
      *) die "mail-secrets: refused name" ;;
    esac
    printf '%s=%s\n' "$name" "$value" >> "$out"
  done <<<"$input"
  mv -f "$out" "$ENV_DIR/mail-providers.env"
  log "mail-secrets updated: $(cut -d= -f1 "$ENV_DIR/mail-providers.env" | tr '\n' ' ')(values not logged)"
}

cmd_web_secrets() {
  # stdin: NAME=value lines for the web tier (§6.12). Same all-or-nothing rule
  # as mail-secrets; the file is mounted into the php container only.
  local input line name value out
  local LC_ALL=C
  input="$(head -c 4096)"
  out="$(mktemp "$ENV_DIR/.web.XXXXXX")"; trap 'rm -f "$out"' RETURN
  while IFS= read -r line || [ -n "$line" ]; do
    [ -z "$line" ] && continue
    name="${line%%=*}"; value="${line#*=}"
    case "$name" in
      TURNSTILE_SITE_KEY|TURNSTILE_SECRET_KEY)
        [[ "$value" =~ ^([A-Za-z0-9_-]{8,128})?$ ]] || die "web-secrets: $name has an unexpected format" ;;
      *) die "web-secrets: refused name" ;;
    esac
    printf '%s=%s\n' "$name" "$value" >> "$out"
  done <<<"$input"
  mv -f "$out" "$ENV_DIR/web.env"
  log "web-secrets updated: $(cut -d= -f1 "$ENV_DIR/web.env" | tr '\n' ' ')(values not logged)"
}

cmd_staff_bootstrap() {
  # stdin: exactly EMAIL= and NAME= lines (§6.19). Neither value is logged:
  # this output reaches the public Actions log. The invitation link goes only
  # to the address, by email; the app refuses once a staff manager is active.
  local input line name value email="" full_name="" current status=0
  local LC_ALL=C
  input="$(head -c 1024)"
  while IFS= read -r line || [ -n "$line" ]; do
    [ -z "$line" ] && continue
    name="${line%%=*}"; value="${line#*=}"
    case "$name" in
      EMAIL) [[ "$value" =~ ^[A-Za-z0-9._%+-]{1,64}@([A-Za-z0-9-]{1,63}\.)+[A-Za-z]{2,63}$ ]] || die "staff-bootstrap: EMAIL has an unexpected format"; email="$value" ;;
      NAME)  [[ "$value" =~ ^[^[:cntrl:]\<\>\"\\\`\$]{2,100}$ ]] || die "staff-bootstrap: NAME has an unexpected format"; full_name="$value" ;;
      *) die "staff-bootstrap: refused name" ;;
    esac
  done <<<"$input"
  [ -n "$email" ] && [ -n "$full_name" ] || die "staff-bootstrap: EMAIL and NAME are required"
  current="$(cat "$STATE_DIR/current" 2>/dev/null || true)"
  [[ "$current" =~ ^[0-9a-f]{40}$ ]] || die "staff-bootstrap: no release is running"
  # Arguments go to the CLI as argv (no shell); its output (staff ID) stays in the host log.
  compose "$current" exec -T php bin/paxoficloud staff:bootstrap "$email" "$full_name" >>"$LOG_FILE" 2>&1 || status=$?
  case "$status" in
    0) log "staff-bootstrap: done: first-admin invitation queued (link by email only, valid 24 hours), or founder roles granted (confirmed by email)" ;;
    2) log "staff-bootstrap: refused (another staff member is active, the address is not the founder's, or it is already staff)"; exit 2 ;;
    *) die "staff-bootstrap: failed (exit $status)" ;;
  esac
}

image_exists() { docker image inspect "$1" >/dev/null 2>&1; }

healthy() {
  local i
  for i in $(seq 1 30); do
    if [ "$(curl -s --max-time 3 "$HEALTH_URL" || true)" = '{"status":"healthy"}' ]; then return 0; fi
    sleep 2
  done
  return 1
}

start_version() {
  local version="$1"
  compose "$version" up -d --wait --wait-timeout 180 --remove-orphans >>"$LOG_FILE" 2>&1
}

cmd_load() {
  # Only gzip'd `docker save` output of our two repositories is accepted.
  local tmp loaded
  tmp="$(mktemp)"; trap 'rm -f "$tmp"' RETURN
  head -c "$MAX_IMAGE_STREAM_BYTES" > "$tmp"
  gzip -t "$tmp" 2>/dev/null || die "load: input is not a gzip stream"
  loaded="$(gunzip -c "$tmp" | docker load | sed -n 's/^Loaded image: //p')"
  [ -n "$loaded" ] || die "load: no images loaded"
  while read -r ref; do
    [[ "$ref" =~ ^paxoficloud-(php|nginx):[0-9a-f]{40}$ ]] || { docker image rm -f "$ref" >/dev/null 2>&1 || true; die "load: unexpected image $ref removed"; }
  done <<<"$loaded"
  log "loaded $(tr '\n' ' ' <<<"$loaded")"
}

cmd_release() {
  local version="$1" current=""
  [[ "$version" =~ ^[0-9a-f]{40}$ ]] || die "release: version must be a 40-character git SHA"
  image_exists "paxoficloud-php:$version" && image_exists "paxoficloud-nginx:$version" || die "release: images for $version are not loaded"
  ensure_secrets "$version"
  [ -f "$STATE_DIR/current" ] && current="$(cat "$STATE_DIR/current")"

  log "release $version (current: ${current:-none})"
  # Data services first, then forward-only migrations with the NEW code (P-8).
  compose "$version" up -d --wait --wait-timeout 180 mysql redis >>"$LOG_FILE" 2>&1 || die "release: mysql/redis did not become healthy"
  if ! as_owner "$version" migrate >>"$LOG_FILE" 2>&1; then
    die "release: migration failed; $version not started, ${current:-nothing} still serving"
  fi
  if ! as_owner "$version" db:grants "$RUNTIME_DB_USER" >>"$LOG_FILE" 2>&1; then
    die "release: runtime grants failed; $version not started, ${current:-nothing} still serving"
  fi

  if start_version "$version" && healthy; then
    [ -n "$current" ] && [ "$current" != "$version" ] && printf '%s\n' "$current" > "$STATE_DIR/previous"
    printf '%s\n' "$version" > "$STATE_DIR/current"
    log "release $version OK"
    prune_images "$version" "$current"
    return 0
  fi

  log "release $version FAILED health check"
  if [ -n "$current" ] && [ "$current" != "$version" ]; then
    if start_version "$current" && healthy; then
      log "rolled back to $current"
    else
      log "ROLLBACK to $current ALSO FAILED: manual intervention required"
    fi
  fi
  exit 1
}

prune_images() {
  # Keep only the running version and the one before it.
  local keep1="$1" keep2="$2" repo ref
  for repo in paxoficloud-php paxoficloud-nginx; do
    docker image ls "$repo" --format '{{.Repository}}:{{.Tag}}' | while read -r ref; do
      case "${ref#*:}" in "$keep1"|"$keep2") ;; *) docker image rm "$ref" >/dev/null 2>&1 || true ;; esac
    done
  done
}

cmd_status() {
  printf 'current=%s\nprevious=%s\n' "$(cat "$STATE_DIR/current" 2>/dev/null || echo none)" "$(cat "$STATE_DIR/previous" 2>/dev/null || echo none)"
  docker ps --filter "label=com.docker.compose.project=$PROJECT" --format '{{.Names}} {{.Status}}'
  mail_status
}

# Mail diagnostics for the (public) Actions log: setting names, the provider
# choice and counts only. No values, hosts or addresses are printed.
mail_status() {
  local f="$ENV_DIR/mail-providers.env" provider allowed current
  provider="$(sed -n 's/^EMAIL_PROVIDER=\(postmark\|resend\|smtp\)$/\1/p' "$f" 2>/dev/null | tail -n 1)"
  allowed="$(sed -n 's/^EMAIL_RECIPIENT_ALLOWLIST=//p' "$f" 2>/dev/null | tail -n 1 | tr ',' '\n' | grep -c '@' || true)"
  printf 'mail worker=%s provider=%s allowlist_entries=%s\n' "$([ -n "$(mail_profile)" ] && echo enabled || echo disabled)" "${provider:-default}" "${allowed:-0}"
  printf 'mail settings set: %s\n' "$(grep -Eo '^[A-Z0-9_]+=.' "$f" 2>/dev/null | cut -d= -f1 | tr '\n' ' ')"
  current="$(cat "$STATE_DIR/current" 2>/dev/null || true)"
  if [[ "$current" =~ ^[0-9a-f]{40}$ ]]; then
    compose "$current" exec -T php bin/paxoficloud mail:status 2>>"$LOG_FILE" || echo "mail:status unavailable"
  fi
}

install -d -m 0700 "$STATE_DIR" "$(dirname "$LOG_FILE")"
read -r -a args <<<"${SSH_ORIGINAL_COMMAND:-}"
case "${args[0]:-}:${#args[@]}" in
  load:1)    cmd_load ;;
  mail-secrets:1) install -d -m 0700 "$ENV_DIR"; cmd_mail_secrets ;;
  web-secrets:1)  install -d -m 0700 "$ENV_DIR"; cmd_web_secrets ;;
  release:2) cmd_release "${args[1]}" ;;
  staff-bootstrap:1) cmd_staff_bootstrap ;;
  status:1)  cmd_status ;;
  *)         log "refused command"; echo "usage: load | mail-secrets | web-secrets | release <sha> | staff-bootstrap | status" >&2; exit 64 ;;
esac
