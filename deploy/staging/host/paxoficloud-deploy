#!/usr/bin/env bash
# PaxofiCloud staging deploy agent: the ONLY command the `deploy` SSH user can
# run (sshd ForceCommand + authorized_keys `restrict,command=`), see
# docs/security/THREAT-MODEL-DEPLOY-PIPELINE.md (P-4, P-7, P-8, D-01, D-08, D-11).
#
# Verbs (from SSH_ORIGINAL_COMMAND; anything else is refused):
#   load               stdin: `docker save ... | gzip` of the two app images
#   mail-secrets       stdin: NAME=value lines for the mail worker (email
#                      threat model E-6); only allow-listed names and formats
#   release <sha>      migrate, start <sha>, health-check; roll back on failure
#   status             current/previous version and container health
#
# Runtime secrets (DB/Redis passwords, the email outbox key pair) are generated
# here on first release and never leave the host. Logs never print secret
# values (P-11).
set -euo pipefail
umask 077

ROOT="${PAXOFICLOUD_ROOT:-}"                      # test harness only; sshd passes no env
COMPOSE_FILE="$ROOT/opt/paxoficloud/compose.yaml"
ENV_DIR="$ROOT/etc/paxoficloud"
STATE_DIR="$ROOT/var/lib/paxoficloud"
LOG_FILE="$ROOT/var/log/paxoficloud/deploy.log"
HEALTH_URL="${PAXOFICLOUD_HEALTH_URL:-http://127.0.0.1:8080/health/ready}"
PROJECT=paxoficloud
MAX_IMAGE_STREAM_BYTES=$((2 * 1024 * 1024 * 1024))

log() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" | tee -a "$LOG_FILE" >&2; }
die() { log "ERROR $*"; exit 1; }

# The mail worker (compose profile "mail") runs only once a provider token exists.
mail_profile() {
  local f="$ENV_DIR/mail-providers.env"
  if grep -Eqs '^(POSTMARK_SERVER_TOKEN|RESEND_API_KEY)=.' "$f" \
     || { grep -Eqs '^SMTP_HOST=.' "$f" && grep -Eqs '^SMTP_PASSWORD_B64=.' "$f"; }; then echo mail; fi
}
compose() { APP_VERSION="$1" PAXOFICLOUD_ENV_DIR="$ENV_DIR" COMPOSE_PROFILES="$(mail_profile)" docker compose -p "$PROJECT" -f "$COMPOSE_FILE" "${@:2}"; }

random_secret() { head -c 32 /dev/urandom | base64 | tr -d '/+=\n' | head -c 40; }

ensure_secrets() {
  local version="$1" f keys
  install -d -m 0700 "$ENV_DIR"
  for f in outbox-public.env outbox-secret.env mail-providers.env; do
    [ -e "$ENV_DIR/$f" ] || install -m 0600 /dev/null "$ENV_DIR/$f"
  done
  if [ ! -s "$ENV_DIR/app.env" ]; then
    local db redis
    db="$(random_secret)"; redis="$(random_secret)"
    printf 'DB_USERNAME=paxoficloud\nDB_PASSWORD=%s\nREDIS_PASSWORD=%s\n' "$db" "$redis" > "$ENV_DIR/app.env"
    printf 'MYSQL_RANDOM_ROOT_PASSWORD=yes\nMYSQL_DATABASE=paxoficloud\nMYSQL_USER=paxoficloud\nMYSQL_PASSWORD=%s\n' "$db" > "$ENV_DIR/mysql.env"
    printf 'REDIS_PASSWORD=%s\n' "$redis" > "$ENV_DIR/redis.env"
    log "generated runtime secrets (values not logged)"
  fi
  if [ ! -s "$ENV_DIR/outbox-public.env" ]; then
    # Email outbox key pair (E-3): the web tier gets the public half only.
    # libsodium in the release image, without booting the app (which needs MySQL).
    keys="$(compose "$version" run --rm -T --no-deps --entrypoint php php -r \
      '$k = sodium_crypto_box_keypair(); echo "EMAIL_OUTBOX_PUBLIC_KEY=", base64_encode(sodium_crypto_box_publickey($k)), "\n", "EMAIL_OUTBOX_SECRET_KEY=", base64_encode(sodium_crypto_box_secretkey($k)), "\n"; sodium_memzero($k);' \
      2>>"$LOG_FILE")" || die "release: could not generate the email outbox keys"
    grep -Eq '^EMAIL_OUTBOX_PUBLIC_KEY=[A-Za-z0-9+/]{43}=$' <<<"$keys" && grep -Eq '^EMAIL_OUTBOX_SECRET_KEY=[A-Za-z0-9+/]{43}=$' <<<"$keys" \
      || die "release: unexpected outbox key output"
    grep '^EMAIL_OUTBOX_SECRET_KEY=' <<<"$keys" > "$ENV_DIR/outbox-secret.env"
    grep '^EMAIL_OUTBOX_PUBLIC_KEY=' <<<"$keys" > "$ENV_DIR/outbox-public.env"
    log "generated email outbox key pair (values not logged)"
  fi
}

cmd_mail_secrets() {
  # stdin: NAME=value lines. Unknown names or values outside the expected
  # format are refused as a whole; nothing is written unless all lines pass.
  local input line name value out
  local LC_ALL=C
  input="$(head -c 8192)"
  out="$(mktemp "$ENV_DIR/.mail-providers.XXXXXX")"; trap 'rm -f "$out"' RETURN
  while IFS= read -r line || [ -n "$line" ]; do
    [ -z "$line" ] && continue
    name="${line%%=*}"; value="${line#*=}"
    case "$name" in
      POSTMARK_SERVER_TOKEN) [[ "$value" =~ ^[A-Za-z0-9-]{0,128}$ ]] || die "mail-secrets: $name has an unexpected format" ;;
      RESEND_API_KEY)        [[ "$value" =~ ^(re_[A-Za-z0-9_]{8,128})?$ ]] || die "mail-secrets: $name has an unexpected format" ;;
      EMAIL_RECIPIENT_ALLOWLIST) [[ "$value" =~ ^[A-Za-z0-9@._+,\ -]{0,2000}$ ]] || die "mail-secrets: $name has an unexpected format" ;;
      EMAIL_PROVIDER)        [[ "$value" =~ ^(postmark|resend|smtp)?$ ]] || die "mail-secrets: $name has an unexpected format" ;;
      SMTP_HOST)             [[ "$value" =~ ^([a-z0-9-]{1,63}\.)+[a-z]{2,63}$ || -z "$value" ]] || die "mail-secrets: $name has an unexpected format" ;;
      SMTP_TLS_NAME)         [[ "$value" =~ ^([a-z0-9-]{1,63}\.)+[a-z]{2,63}$ || -z "$value" ]] || die "mail-secrets: $name has an unexpected format" ;;
      SMTP_PORT)             [[ "$value" =~ ^(465|587)?$ ]] || die "mail-secrets: $name has an unexpected format" ;;
      SMTP_USERNAME)         [[ "$value" =~ ^[A-Za-z0-9@._+-]{0,254}$ ]] || die "mail-secrets: $name has an unexpected format" ;;
      SMTP_PASSWORD)
        # Any printable password (no spaces). Stored base64-encoded so `$`,
        # quotes or `#` cannot be reinterpreted by the compose env file.
        [[ "$value" =~ ^[[:graph:]]{0,256}$ ]] || die "mail-secrets: $name has an unexpected format"
        name=SMTP_PASSWORD_B64
        if [ -n "$value" ]; then value="$(printf '%s' "$value" | base64 -w0)"; fi ;;
      *) die "mail-secrets: refused name" ;;
    esac
    printf '%s=%s\n' "$name" "$value" >> "$out"
  done <<<"$input"
  mv -f "$out" "$ENV_DIR/mail-providers.env"
  log "mail-secrets updated: $(cut -d= -f1 "$ENV_DIR/mail-providers.env" | tr '\n' ' ')(values not logged)"
}

image_exists() { docker image inspect "$1" >/dev/null 2>&1; }

healthy() {
  local i
  for i in $(seq 1 30); do
    if [ "$(curl -s --max-time 3 "$HEALTH_URL" || true)" = '{"status":"healthy"}' ]; then return 0; fi
    sleep 2
  done
  return 1
}

start_version() {
  local version="$1"
  compose "$version" up -d --wait --wait-timeout 180 --remove-orphans >>"$LOG_FILE" 2>&1
}

cmd_load() {
  # Only gzip'd `docker save` output of our two repositories is accepted.
  local tmp loaded
  tmp="$(mktemp)"; trap 'rm -f "$tmp"' RETURN
  head -c "$MAX_IMAGE_STREAM_BYTES" > "$tmp"
  gzip -t "$tmp" 2>/dev/null || die "load: input is not a gzip stream"
  loaded="$(gunzip -c "$tmp" | docker load | sed -n 's/^Loaded image: //p')"
  [ -n "$loaded" ] || die "load: no images loaded"
  while read -r ref; do
    [[ "$ref" =~ ^paxoficloud-(php|nginx):[0-9a-f]{40}$ ]] || { docker image rm -f "$ref" >/dev/null 2>&1 || true; die "load: unexpected image $ref removed"; }
  done <<<"$loaded"
  log "loaded $(tr '\n' ' ' <<<"$loaded")"
}

cmd_release() {
  local version="$1" current=""
  [[ "$version" =~ ^[0-9a-f]{40}$ ]] || die "release: version must be a 40-character git SHA"
  image_exists "paxoficloud-php:$version" && image_exists "paxoficloud-nginx:$version" || die "release: images for $version are not loaded"
  ensure_secrets "$version"
  [ -f "$STATE_DIR/current" ] && current="$(cat "$STATE_DIR/current")"

  log "release $version (current: ${current:-none})"
  # Data services first, then forward-only migrations with the NEW code (P-8).
  compose "$version" up -d --wait --wait-timeout 180 mysql redis >>"$LOG_FILE" 2>&1 || die "release: mysql/redis did not become healthy"
  if ! compose "$version" run --rm -T --no-deps php bin/paxoficloud migrate >>"$LOG_FILE" 2>&1; then
    die "release: migration failed; $version not started, ${current:-nothing} still serving"
  fi

  if start_version "$version" && healthy; then
    [ -n "$current" ] && [ "$current" != "$version" ] && printf '%s\n' "$current" > "$STATE_DIR/previous"
    printf '%s\n' "$version" > "$STATE_DIR/current"
    log "release $version OK"
    prune_images "$version" "$current"
    return 0
  fi

  log "release $version FAILED health check"
  if [ -n "$current" ] && [ "$current" != "$version" ]; then
    if start_version "$current" && healthy; then
      log "rolled back to $current"
    else
      log "ROLLBACK to $current ALSO FAILED: manual intervention required"
    fi
  fi
  exit 1
}

prune_images() {
  # Keep only the running version and the one before it.
  local keep1="$1" keep2="$2" repo ref
  for repo in paxoficloud-php paxoficloud-nginx; do
    docker image ls "$repo" --format '{{.Repository}}:{{.Tag}}' | while read -r ref; do
      case "${ref#*:}" in "$keep1"|"$keep2") ;; *) docker image rm "$ref" >/dev/null 2>&1 || true ;; esac
    done
  done
}

cmd_status() {
  printf 'current=%s\nprevious=%s\n' "$(cat "$STATE_DIR/current" 2>/dev/null || echo none)" "$(cat "$STATE_DIR/previous" 2>/dev/null || echo none)"
  docker ps --filter "label=com.docker.compose.project=$PROJECT" --format '{{.Names}} {{.Status}}'
  mail_status
}

# Mail diagnostics for the (public) Actions log: setting names, the provider
# choice and counts only. No values, hosts or addresses are printed.
mail_status() {
  local f="$ENV_DIR/mail-providers.env" provider allowed current
  provider="$(sed -n 's/^EMAIL_PROVIDER=\(postmark\|resend\|smtp\)$/\1/p' "$f" 2>/dev/null | tail -n 1)"
  allowed="$(sed -n 's/^EMAIL_RECIPIENT_ALLOWLIST=//p' "$f" 2>/dev/null | tail -n 1 | tr ',' '\n' | grep -c '@' || true)"
  printf 'mail worker=%s provider=%s allowlist_entries=%s\n' "$([ -n "$(mail_profile)" ] && echo enabled || echo disabled)" "${provider:-default}" "${allowed:-0}"
  printf 'mail settings set: %s\n' "$(grep -Eo '^[A-Z0-9_]+=.' "$f" 2>/dev/null | cut -d= -f1 | tr '\n' ' ')"
  current="$(cat "$STATE_DIR/current" 2>/dev/null || true)"
  if [[ "$current" =~ ^[0-9a-f]{40}$ ]]; then
    compose "$current" exec -T php bin/paxoficloud mail:status 2>>"$LOG_FILE" || echo "mail:status unavailable"
  fi
}

install -d -m 0700 "$STATE_DIR" "$(dirname "$LOG_FILE")"
read -r -a args <<<"${SSH_ORIGINAL_COMMAND:-}"
case "${args[0]:-}:${#args[@]}" in
  load:1)    cmd_load ;;
  mail-secrets:1) install -d -m 0700 "$ENV_DIR"; cmd_mail_secrets ;;
  release:2) cmd_release "${args[1]}" ;;
  status:1)  cmd_status ;;
  *)         log "refused command"; echo "usage: load | mail-secrets | release <sha> | status" >&2; exit 64 ;;
esac
