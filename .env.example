# Copy to .env for local development only. Never commit .env.
# Staging and production read real values from the environment/secret store.
APP_ENV=development
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080
APP_PORT=8080

# Used by both the app and docker compose. Pick your own local passwords.
DB_DATABASE=paxoficloud
DB_USERNAME=paxoficloud
DB_PASSWORD=change-me-local-only
DB_PORT=3306
# When running PHP on the host instead of in Docker:
DB_DSN="mysql:host=127.0.0.1;port=3306;dbname=paxoficloud;charset=utf8mb4"

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=change-me-local-only

# Transactional email (docs/security/THREAT-MODEL-TRANSACTIONAL-EMAIL.md).
# Provider tokens and the outbox secret key belong to the mail worker only.
EMAIL_PROVIDER=postmark
EMAIL_FROM_NAME=PaxofiCloud
EMAIL_FROM_ADDRESS=no-reply@paxofi.com
# Outside production only these recipients (addresses or @domains) are emailed.
EMAIL_RECIPIENT_ALLOWLIST=@paxofi.com
EMAIL_HOURLY_CAP=500
# Generate with: bin/paxoficloud mail:keygen
EMAIL_OUTBOX_PUBLIC_KEY=
EMAIL_OUTBOX_SECRET_KEY=
POSTMARK_SERVER_TOKEN=
RESEND_API_KEY=
